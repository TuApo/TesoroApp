<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lector de huella por OTG: al conectarlo, Android ofrece abrir esta
                 aplicacion y concede el permiso USB de una vez, en lugar de volver a
                 preguntarlo en cada captura. La lista de fabricantes reconocidos esta
                 en res/xml/device_filter_huella.xml. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter_huella" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camara: la usan el lector de QR del carne y la captura de foto de contratacion.
         Sin este permiso DECLARADO, el WebView de Capacitor ni siquiera llega a PREGUNTAR
         al usuario: getUserMedia falla directamente con NotAllowedError. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- required="false": que un dispositivo sin camara (tablet de oficina) pueda seguir
         instalando la app. Las pantallas que la usan ya degradan a busqueda por cedula. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Ubicacion: el campo LOCATION de Formularios Dinamicos usa navigator.geolocation.
         Sin el permiso DECLARADO, el WebView de Capacitor falla sin preguntar (mismo
         gotcha que la camara). El campo degrada con mensaje claro si se deniega. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- USB host: hace falta para hablar con un lector de huella conectado por OTG.
         required="false" a proposito, igual que la camara: un telefono sin USB host
         debe poder instalar la aplicacion, y la pantalla degrada a adjuntar imagen. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
</manifest>
