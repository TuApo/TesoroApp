<?xml version="1.0" encoding="utf-8"?>
<!--
  Lectores de huella que la aplicacion reconoce al conectarse por OTG.

  Se filtra SOLO por fabricante (vendor-id) y a proposito: cada marca tiene
  decenas de modelos con product-id distinto, y el fabricante saca nuevos sin
  avisar. Filtrando por casa, un Hamster Pro 30 que reemplace a un Pro 20
  funciona sin tocar este archivo ni republicar el APK.

  Los identificadores son los del registro oficial de USB (usb.ids).
-->
<resources>
    <!-- 0x1162 = 4450 · Secugen Corp. (familia Hamster, modulos U10/U20/U30) -->
    <usb-device vendor-id="4450" />

    <!-- 0x05BA = 1466 · DigitalPersona / HID (U.are.U 5160 y 5100;
         la 4500 responde a este mismo id pero NO tiene SDK de Android) -->
    <usb-device vendor-id="1466" />

    <!-- 0x1491 = 5265 · Futronic (FS80H, FS82, FS88, FS26, FS10) -->
    <usb-device vendor-id="5265" />

    <!-- 0x16D1 = 5841 · Suprema (BioMini) -->
    <usb-device vendor-id="5841" />
</resources>
