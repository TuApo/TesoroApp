# node_modules aqui es un SYMLINK a frontend/TesoroApp/node_modules. Docker lo copia como
# enlace colgante y pisa el node_modules que acaba de crear `npm install` en la capa anterior:
# el build moria con "sh: ng: not found". Excluirlo es lo que hace el Dockerfile reproducible.
node_modules
dist
.angular
.git
android
electron-dist
*.log

# Cachés que deja build-android.sh, propiedad de root: docker no puede leer
# .apt-cache-jdk21/partial y el build muere con "permission denied" al armar el
# contexto. No pintan nada en la imagen.
.apt-cache-jdk21
.gradle-cache
.npm-cache
