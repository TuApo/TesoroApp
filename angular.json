{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "Tesoreria": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/tesoreria",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "prerender": false,
            "baseHref": "./",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "./"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/assets",
                "output": "/assets"
              },
              {
                "glob": "vision_wasm_internal.{js,wasm}",
                "input": "node_modules/@mediapipe/tasks-vision/wasm",
                "output": "/mediapipe/wasm"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.css"
            ],
            "scripts": [],
            "server": "src/main.server.ts",
            "ssr": {
              "entry": "src/server.ts"
            },
            "allowedCommonJsDependencies": [
              "canvg",
              "jspdf",
              "@babel/runtime",
              "core-js",
              "raf",
              "rgbcolor",
              "moment",
              "exceljs",
              "archiver",
              "readable-stream",
              "unzipper",
              "tmp",
              "fast-csv",
              "dayjs",
              "dayjs/plugin/customParseFormat",
              "dayjs/plugin/utc",
              "saxes",
              "file-saver",
              "jszip",
              "fast-deep-equal",
              "unicode-trie",
              "dfa",
              "clone",
              "tiny-inflate",
              "brotli/decompress.js",
              "base64-js",
              "pako",
              "qrcode",
              "uuid"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4MB",
                  "maximumError": "6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "150kb",
                  "maximumError": "500kb"
                }
              ],
              "sourceMap": {
                "scripts": true,
                "styles": true,
                "vendor": true
              },
              "outputHashing": "all"
            },
            "development": {
              "baseHref": "/",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "build-electron": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/tesoreria/browser",
            "index": "src/index.html",
            "main": "src/main.ts",
            "baseHref": "./",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.electron.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "output": "./"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/assets",
                "output": "/assets"
              },
              {
                "glob": "vision_wasm_internal.{js,wasm}",
                "input": "node_modules/@mediapipe/tasks-vision/wasm",
                "output": "/mediapipe/wasm"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.css"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "canvg",
              "jspdf",
              "@babel/runtime",
              "core-js",
              "raf",
              "rgbcolor",
              "moment",
              "exceljs",
              "archiver",
              "readable-stream",
              "unzipper",
              "tmp",
              "fast-csv",
              "dayjs",
              "dayjs/plugin/customParseFormat",
              "dayjs/plugin/utc",
              "saxes",
              "file-saver",
              "jszip",
              "fast-deep-equal",
              "unicode-trie",
              "dfa",
              "clone",
              "tiny-inflate",
              "brotli/decompress.js",
              "base64-js",
              "pako",
              "sweetalert2",
              "qrcode",
              "uuid"
            ],
            "fileReplacements": [
              {
                "replace": "src/app/app.config.ts",
                "with": "src/app/app.config.electron.ts"
              }
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4MB",
                  "maximumError": "6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "150kb",
                  "maximumError": "500kb"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              },
              "buildOptimizer": true,
              "aot": true,
              "extractLicenses": true,
              "sourceMap": false,
              "namedChunks": false,
              "vendorChunk": false,
              "outputHashing": "all"
            },
            "development": {
              "baseHref": "/",
              "optimization": false,
              "buildOptimizer": false,
              "aot": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "vendorChunk": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                },
                {
                  "replace": "src/app/app.config.ts",
                  "with": "src/app/app.config.electron.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Tesoreria:build:production"
            },
            "development": {
              "buildTarget": "Tesoreria:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve-electron": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Tesoreria:build-electron:production"
            },
            "development": {
              "buildTarget": "Tesoreria:build-electron:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/azure-blue.css",
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "5c11af64-41ab-449d-80e3-a30dac7cb48a"
  }
}